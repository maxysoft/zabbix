{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["(?<depName>aquasec/trivy):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^backup/Dockerfile$/"],
      "matchStrings": ["ARG AGE_VERSION=(?<currentValue>v\\S+)"],
      "depNameTemplate": "filippo.io/age",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["zabbix/**"],
      "groupName": "zabbix"
    },
    {
      "matchPackageNames": ["zabbix/**"],
      "matchCurrentValue": "alpine-trunk",
      "enabled": false
    },
    {
      "matchPackageNames": ["timescale/timescaledb"],
      "allowedVersions": "/^2\\.2[0-9]\\.\\d+-pg18$/"
    }
  ]
}
